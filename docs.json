{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Synopta Docs",
  "colors": {
    "primary": "#6D28D9",
    "light": "#8B5CF6",
    "dark": "#4C1D95"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Frontier",
        "icon": "monitor",
        "groups": [
          {
            "group": "Frontier",
            "pages": [
              "frontier/overview",
              {
                "group": "Reference",
                "expanded": false,
                "pages": [
                  "frontier/authentication",
                  "frontier/realtime-data",
                  "frontier/api-proxy",
                  "frontier/pages",
                  "frontier/environment"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/synopta",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "http://localhost:3000"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/synopta"
    }
  }
}
